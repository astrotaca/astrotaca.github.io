# Local development settings for `npm run dev`.
# Copy this file to .dev.vars and fill in your TEST keys. .dev.vars is gitignored.
# Production secrets are set with `npx wrangler secret put <NAME>`, never in a file.

# Stripe restricted key from TEST mode (Developers > API keys > Create restricted key).
# Starts with rk_test_. See SHOP.md for the permissions it needs.
STRIPE_SECRET_KEY=

# Printed by `stripe listen --forward-to localhost:8787/api/webhook` (starts with whsec_).
STRIPE_WEBHOOK_SECRET=

# Optional: a Discord channel webhook URL that gets a short note for each paid order.
ORDER_NOTIFY_WEBHOOK=

# Local overrides for the public settings in wrangler.jsonc.
SITE_URL=http://localhost:8787
SHOP_SHIP_COUNTRIES=NO,SE,DK,DE,GB,US
